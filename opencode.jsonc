{
  "$schema": "https://opencode.ai/config.json",

  // ===========================================================================
  // OpenCode Project Configuration Template
  // ===========================================================================
  // This file provides commented examples of ALL available configuration
  // options. Uncomment and modify sections as needed for this project.
  // Project config overrides global config (~/.config/opencode/opencode.jsonc)
  // ===========================================================================

  // --- MCP Servers -----------------------------------------------------------
  // Configure Model Context Protocol servers
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  },

  "provider": {
    "openai": {
      "models": {
        "gpt-5.4": {
          "variants": {
            "minimal": { "disabled": true },
            "low": { "disabled": true }
          }
        },
        "gpt-5.3-codex": {
          "variants": {
            "minimal": { "disabled": true },
            "low": { "disabled": true }
          }
        }
      }
    }
  },


  "agent": {
    "plan": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high"
    },
    "build": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high"
    },
    "quick-question": {
      "description": "For any simple research tasks and question that already have clear context and need simple execution or deduction.",
      "prompt": "You are a helpful assistant that can help with simple tasks and questions. You can use skills and tools. You must always use prior context to answer and request for more information if needed. Your answer must be a self-sufficient recap of the takeaways you found during your research.",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "implementation": {
      "description": "For simple spec implementation task. Explain work, scope, decisions, goals, non-goals, etc. (like a mini prd) and this agent will implement it.",
      "prompt": "You are a senior developer. You will implement the user's spec given to you. You will explain your work, scope, decisions, goals, non-goals, etc. (like a mini prd) and this agent will implement it. If something appears to be missing or ambiguous, ask the user for clarification before any implementation.",
      "mode": "subagent",
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "code-reviewer-primary": {
      "description": "For code review by primary reviewer (preferred)",
      "prompt": "You are a critical code reviewer expert. You will track for what user asked you, using the most suitable skill available if any, to give detailed feedback. If no specific instruction you will want to deeply review the user changes with all the needed skill and knowledge and documentation.",
      "mode": "subagent",
      "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "code-reviewer-secondary": {
      "description": "For code review by secondary reviewer (EXPENSIVE, please use only if primary reviewer feedback isn't good enough.)",
      "prompt": "You are a critical code reviewer expert. You will track for what user asked you, using the most suitable skill available if any, to give detailed feedback. If no specific instruction you will want to deeply review the user changes with all the needed skill and knowledge and documentation.",
      "mode": "subagent",
      "model": "opencode/claude-opus-4-6",
      "reasoningEffort": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  },
  "small_model": "openai/gpt-5.1-codex-mini",

  "command": {
    "quick": {
      "agent": "quick-question",
      "subtask": true,
      "template": "Answer briefly: {{input}}"
    }
  },

  // --- Instructions ----------------------------------------------------------
  // Include instruction files for the model
  "instructions": [
    ".llms/memory/core_facts.txt",
    ".llms/memory/mental_board.txt"
    // ".cursor/rules/*.md",
    // ".cursor/rules/**/*.mdc",
    // "docs/CONTRIBUTING.md",
    // "docs/ARCHITECTURE.md",
    // ".github/CODING_STANDARDS.md"
  ],

  // --- Disabled Providers ----------------------------------------------------
  // Disable specific providers even if credentials are available
  "disabled_providers": [
    // "openai",
    // "opencode",
    "zen",
    "anthropic",
    "google"
  ]
}

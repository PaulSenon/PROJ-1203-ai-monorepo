{
  "name": "ai-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "deploy:infra": "turbo -F @ai-monorepo/infra deploy",
    "deploy:convex": "turbo -F @ai-monorepo/convex deploy",
    "deploy": "pnpm deploy:convex && pnpm deploy:infra",
    "destroy:infra": "turbo -F @ai-monorepo/infra deploy",
    "destroy": "pnpm destroy:infra"
  },
  "dependencies": {
    "@t3-oss/env-core": "catalog:env",
    "cross-env": "^10.1.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-monorepo/config": "workspace:*",
    "@biomejs/biome": "2.3.0",
    "@cloudflare/workers-types": "^4.20250822.0",
    "@types/node": "^22.13.11",
    "alchemy": "catalog:",
    "opencode-ai": "^1.2.1",
    "tsdown": "catalog:",
    "turbo": "^2.5.4",
    "ultracite": "6.0.4"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}

{
  "name": "ai-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "lint:staged": "pnpm exec biome check --staged --no-errors-on-unmatched",
    "lint:fix:staged": "pnpm exec biome check --write --staged --no-errors-on-unmatched",
    "check": "pnpm lint && pnpm check-types",
    "hooks:install": "husky",
    "prepare": "pnpm run hooks:install",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "deploy:infra": "turbo -F @ai-monorepo/infra deploy",
    "deploy:convex": "turbo -F @ai-monorepo/convex deploy",
    "deploy": "pnpm deploy:convex && pnpm deploy:infra",
    "destroy:infra": "turbo -F @ai-monorepo/infra deploy",
    "destroy": "pnpm destroy:infra"
  },
  "dependencies": {
    "@t3-oss/env-core": "catalog:env",
    "cross-env": "^10.1.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-monorepo/config": "workspace:*",
    "@biomejs/biome": "2.3.0",
    "@cloudflare/workers-types": "^4.20250822.0",
    "@types/node": "^22.13.11",
    "alchemy": "catalog:",
    "husky": "^9.1.7",
    "opencode-ai": "^1.2.1",
    "tsdown": "catalog:",
    "turbo": "^2.5.4",
    "ultracite": "6.0.4"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}

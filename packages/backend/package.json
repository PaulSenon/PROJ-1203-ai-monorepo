{
  "name": "@ai-monorepo/convex",
  "version": "1.0.0",
  "description": "Convex backend",
  "scripts": {
    "dev": "convex dev",
    "dev:setup": "convex dev --configure --until-success",
    "deploy": "convex deploy",
    "check-types": "tsc --noEmit",
    "migrate:check-dev": "convex run --component migrations lib:getStatus --watch",
    "migrate:check-prod": "convex run --component migrations lib:getStatus --watch --prod",
    "migrate:dev": "convex run migrations:runAll && pnpm run migrate:check-dev",
    "migrate:prod": "convex run migrations:runAll --prod && pnpm run migrate:check-prod"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@ai-monorepo/ai": "workspace:*",
    "@convex-dev/migrations": "catalog:convex",
    "@convex-dev/workpool": "catalog:convex",
    "@ai-monorepo/config": "workspace:*",
    "convex": "catalog:convex",
    "convex-helpers": "catalog:convex"
  }
}

# Development environment base image
FROM node:22-slim

WORKDIR /app

RUN apt-get update && \
  apt-get install -y git make nano curl jq openssh-server ca-certificates && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/*

RUN npm install -g agent-browser && \
  agent-browser install --with-deps

COPY package.json .
COPY pnpm-lock.yaml .

# Install system dependencies and package manager
RUN npm install -g corepack && \
  corepack enable && \
  corepack prepare --activate

# sshd runtime dirs
RUN mkdir -p /run/sshd
# create a user (avoid root)
RUN useradd -m -s /bin/bash dev && passwd -d dev
# allow key auth only
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config \
 && sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config
EXPOSE 22

CMD ["/usr/sbin/sshd","-D","-e"]
